<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net9.0-android</TargetFramework>
        <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ApplicationId>com.omnicasa.mobile</ApplicationId>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <!-- Disable aggressive trimming; Compose/CameraX Java deps are only referenced from Kotlin, not C# -->
        <AndroidLinkMode>None</AndroidLinkMode>
    </PropertyGroup>
    <ItemGroup>
      <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.7.1.4" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\Omnicasa.Mobile.BlinkID.UX.Maui.Droid\Omnicasa.Mobile.BlinkID.UX.Maui.Droid.csproj" />
    </ItemGroup>
    <!-- Remove duplicate Compose runtime-annotation JVM jar (already included in the Android AAR variant) -->
    <Target Name="_RemoveDuplicateComposeAnnotation" BeforeTargets="_CompileToDalvik">
        <ItemGroup>
            <_JavaLibrariesToCompileForApp Remove="@(_JavaLibrariesToCompileForApp)" Condition="$([System.String]::Copy('%(Identity)').Contains('runtime-annotation-jvm'))" />
        </ItemGroup>
    </Target>
</Project>
