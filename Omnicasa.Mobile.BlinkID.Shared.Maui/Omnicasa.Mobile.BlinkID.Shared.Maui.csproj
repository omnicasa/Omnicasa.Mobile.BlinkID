<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios;</TargetFrameworks>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningsAsErrors>true</WarningsAsErrors>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">12.2</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>

		<PackageId>Omnicasa.Mobile.BlinkID.Maui.Shared</PackageId>
		<Version>1.0.0</Version>
		<Authors>HoangQuach</Authors>
		<Company>Omnicasa</Company>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<RepositoryUrl>https://github.com/omnicasa/Omnicasa.Mobile.BlinkID</RepositoryUrl> 
		<RepositoryType>git</RepositoryType> 
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-ios|AnyCPU'">
	  <CreatePackage>false</CreatePackage>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.120" />
		<PackageReference Include="System.Reactive" Version="6.0.1" />
		<PackageReference Include="Omnicasa.Mobile.BlinkID.Shared" Version="2024.8.16.59-preview" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>
	
	<!-- Build the bindings from source instead of the published packages, to test
	     unreleased binding changes. Must be an ENVIRONMENT variable, not -p:, so it
	     reaches this project's restore when built via a ProjectReference:
	         UseLocalBindings=true dotnet build ... -->
	<PropertyGroup>
		<UseLocalBindings Condition="'$(UseLocalBindings)' == ''">false</UseLocalBindings>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
	  <PackageReference Include="Omnicasa.Mobile.BlinkID.UX.Maui.Droid" Version="2026.2.12.79-alpha" Condition="'$(UseLocalBindings)' != 'true'" />
	  <ProjectReference Include="..\Omnicasa.Mobile.BlinkID.UX.Maui.Droid\Omnicasa.Mobile.BlinkID.UX.Maui.Droid.csproj" Condition="'$(UseLocalBindings)' == 'true'" />
	  <!-- MAUI 9.0.120 pins these below what BlinkID v8's CameraX 1.6.1 pulls in -->
	  <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.8.9.3" />
	  <PackageReference Include="Xamarin.AndroidX.Lifecycle.Common.Java8" Version="2.11.0.1" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0-ios'">
	  <PackageReference Include="Omnicasa.Mobile.BlinkID.Maui.iOS" Version="2026.2.12.79-alpha" Condition="'$(UseLocalBindings)' != 'true'" />
	  <ProjectReference Include="..\Omnicasa.Mobile.BlinkID.Maui.iOS\Omnicasa.Mobile.BlinkID.Maui.iOS.csproj" Condition="'$(UseLocalBindings)' == 'true'" />
	</ItemGroup>
</Project>
