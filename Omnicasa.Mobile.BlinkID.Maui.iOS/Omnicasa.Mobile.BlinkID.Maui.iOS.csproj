<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-ios</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <IsBindingProject>true</IsBindingProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoBindingEmbedding>true</NoBindingEmbedding>
    <WarningAsError>false</WarningAsError>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    
    <PackageId>Omnicasa.Mobile.BlinkID.Maui.iOS</PackageId>
    <Version>0.0.0.0</Version>
    <Authors>HoangQuach</Authors>
    <Company>Omnicasa</Company>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RepositoryUrl>https://github.com/omnicasa/Omnicasa.Mobile.BlinkID</RepositoryUrl> 
    <RepositoryType>git</RepositoryType> 
  </PropertyGroup>

  <ItemGroup>
    <ObjcBindingApiDefinition Include="ApiDefinition.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shim carries the ObjC surface; BlinkID/BlinkIDUX are its Swift dependencies. -->
    <NativeReference Include="..\NativeLib\OmnBlinkIDShim.xcframework">
      <Kind>Framework</Kind>
      <SmartLink>False</SmartLink>
    </NativeReference>
    <NativeReference Include="..\NativeLib\BlinkID.xcframework">
      <Kind>Framework</Kind>
      <SmartLink>False</SmartLink>
    </NativeReference>
    <NativeReference Include="..\NativeLib\BlinkIDUX.xcframework">
      <Kind>Framework</Kind>
      <SmartLink>False</SmartLink>
    </NativeReference>
  </ItemGroup>
</Project>
